    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-md bg-gradient-to-br from-blue-600 to-indigo-500 flex items-center justify-center text-white font-bold shadow">ET</div>
      <div>
        <%= link_to root_path, class: "text-lg font-extrabold text-gray-900 hover:underline" do %>
