<% content_for :title, @transaction.name.presence || "Transaction" %>

<div class="min-h-screen w-full bg-gray-50 px-12 py-10">

  <div class="max-w-3xl mx-auto space-y-6">

    <% if notice.present? %>
      <div class="rounded-lg bg-green-50 border border-green-200 text-green-700 px-4 py-3 shadow-sm">
        <%= notice %>
      </div>
    <% end %>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 space-y-6">
      <%= render @transaction %>
    </div>

    <div class="flex flex-wrap gap-4 mt-4">
      <%= link_to "Edit Transaction",
            edit_transaction_path(@transaction),
            class: "bg-blue-600 text-white px-5 py-2 rounded-lg font-medium shadow-md hover:bg-blue-700 hover:shadow-lg transition" %>

      <%= link_to "Back to Transactions",
            transactions_path,
            class: "bg-gray-100 text-gray-800 px-5 py-2 rounded-lg font-medium hover:bg-gray-200 transition" %>

      <%= button_to "Destroy Transaction", @transaction, method: :delete,
            data: { confirm: "Are you sure you want to delete this transaction?" },
            class: "bg-red-600 text-white px-5 py-2 rounded-lg font-medium shadow-md hover:bg-red-700 hover:shadow-lg transition" %>
    </div>

  </div>

</div>
