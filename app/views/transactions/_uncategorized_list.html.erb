<%# Partial: list of uncategorized transactions (used by AJAX refresh) %>
<% transactions.each do |t| %>
  <div class="p-4 rounded-lg border border-gray-200 bg-gray-50 draggable-transaction" draggable="true" data-transaction-id="<%= t.id %>">
    <div class="flex justify-between items-start">
      <div class="min-w-0">
        <div class="flex items-center space-x-2">
          <div class="text-sm text-gray-500 truncate"><%= t.account_name %></div>
          <%# Type badge: Income (green) or Expense (red) %>
          <% tt = t.transaction_type.to_s.downcase %>
          <% if tt == 'income' %>
            <div class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded bg-green-100 text-green-800">Income</div>
          <% else %>
            <div class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded bg-red-100 text-red-800">Expense</div>
          <% end %>
        </div>
        <div class="font-medium text-gray-900 truncate"><%= t.name %></div>
      </div>
      <div class="text-right ml-4 flex-shrink-0">
        <div class="font-semibold">$<%= number_with_precision(t.amount || 0, precision: 2) %></div>
        <div class="text-xs text-gray-500"><%= l(t.created_at, format: :short) if t.created_at %></div>
      </div>
    </div>
  </div>
<% end %>
