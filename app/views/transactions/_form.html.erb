<%= form_with(model: transaction, class: "space-y-6") do |form| %>

  <% if transaction.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md">
      <h2 class="font-semibold mb-2"><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:</h2>
      <ul class="list-disc list-inside text-sm">
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex items-center gap-4">
    <%= form.label :name, class: "w-44 text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.label :amount, class: "w-44 text-sm font-medium text-gray-700" %>
    <%= form.number_field :amount, step: 0.01, class: "flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.label :transaction_type, class: "w-44 text-sm font-medium text-gray-700" %>
    <%= form.select :transaction_type, options_for_select(Transaction.transaction_types.keys.map { |k| [k.humanize, k] }, transaction.transaction_type), {}, class: "flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.label :account_name, class: "w-44 text-sm font-medium text-gray-700" %>
    <%= form.text_field :account_name, class: "flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.label :category_id, "Category", class: "w-44 text-sm font-medium text-gray-700" %>
    <%= form.select :category_id, options_for_select(@categories.map { |c| [c.name, c.id] }, transaction.category_id), {}, class: "flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.label :to_be_reimbursed, class: "w-44 text-sm font-medium text-gray-700" %>
    <div class="flex-1">
      <label class="inline-flex items-center">
        <%= form.check_box :to_be_reimbursed, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
        <span class="ml-2 text-sm text-gray-700">Reimbursable</span>
      </label>
    </div>
  </div>

  <div class="flex justify-end gap-3 pt-4">
    <%= link_to "Cancel", transactions_path, class: "px-4 py-2 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200" %>
    <%= form.submit transaction.new_record? ? "Create Transaction" : "Save Transaction", class: "px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700" %>
  </div>

<% end %>
