<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Expense Tracking" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Expense Tracking">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">

    <!-- Shared top navigation -->
    <%= render 'shared/top_nav' %>

    <!-- Page content -->
    <main class="container mx-auto mt-5 px-5">
      <% if flash.any? %>
        <div class="mb-4">
          <% flash.each do |key, msg| %>
            <% k = key.respond_to?(:to_sym) ? key.to_sym : key %>
            <div class="rounded-md px-4 py-3 mb-2 <%= k == :notice ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <%= msg %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

  </body>
</html>
