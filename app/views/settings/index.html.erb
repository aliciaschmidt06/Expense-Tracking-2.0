<div class="max-w-4xl mx-auto px-6 md:px-12 py-8">
  <h1 class="text-2xl font-semibold mb-4">Settings</h1>

  <%# Flash notices are shown in the application layout to avoid duplicates.
      If you want a contextual settings banner, we can render a custom
      in-page summary here (without duplicating the global flash). %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="p-6 bg-white rounded-lg shadow">
      <h2 class="text-lg font-semibold">Clear all transactions</h2>
      <p class="mt-2 text-sm text-gray-600">This will permanently delete all transactions from the database.</p>
      <div class="mt-4">
        <%= form_with url: settings_clear_transactions_path, method: :post, local: true, id: 'clear-transactions-form' do %>
          <%= hidden_field_tag :confirm_token, '', id: 'clear-transactions-token' %>
          <%= submit_tag 'Clear all transactions', class: 'w-full bg-red-600 text-white py-2 rounded', data: { confirm: false } %>
        <% end %>
      </div>
    </div>

    <div class="p-6 bg-white rounded-lg shadow">
      <h2 class="text-lg font-semibold">Clear all categories</h2>
      <p class="mt-2 text-sm text-gray-600">This will permanently delete all categories from the database.</p>
      <div class="mt-4">
        <%= form_with url: settings_clear_categories_path, method: :post, local: true, id: 'clear-categories-form' do %>
          <%= hidden_field_tag :confirm_token, '', id: 'clear-categories-token' %>
          <%= submit_tag 'Clear all categories', class: 'w-full bg-red-600 text-white py-2 rounded', data: { confirm: false } %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    function confirmAndSubmit(formId, tokenFieldId) {
      // Ask the user to type the word in lowercase for consistency with the
      // UI copy. We accept any case (by normalizing) but the prompt now
      // explicitly shows 'delete' so it's clear and easier to type.
      const input = prompt('Type \'delete\' to confirm this permanent action:')
      if (!input) return
      if (input.trim().toLowerCase() !== 'delete') {
        alert('Confirmation text did not match. Action cancelled.')
        return
      }
      // set a couple characters into a hidden field to prevent accidental double-submit
      document.getElementById(tokenFieldId).value = 'confirmed'
      document.getElementById(formId).submit()
    }

    const txForm = document.getElementById('clear-transactions-form')
    if (txForm) {
      txForm.addEventListener('submit', function(e){
        e.preventDefault()
        confirmAndSubmit('clear-transactions-form','clear-transactions-token')
      })
    }

    const catForm = document.getElementById('clear-categories-form')
    if (catForm) {
      catForm.addEventListener('submit', function(e){
        e.preventDefault()
        confirmAndSubmit('clear-categories-form','clear-categories-token')
      })
    }
  })()
</script>
