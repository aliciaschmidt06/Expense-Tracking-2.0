<% content_for :title, "Categories" %>

<div class="min-h-screen w-full bg-gray-50 px-12 py-10">

  <% if notice.present? %>
    <div class="mb-6 rounded-lg bg-green-50 border border-green-200 text-green-700 px-4 py-3 shadow-sm">
      <%= notice %>
    </div>
  <% end %>

  <!-- Header with title and upload button -->
  <div class="flex flex-col md:flex-row items-center justify-between mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 mb-4 md:mb-0">
      Categories
    </h1>

    <!-- Upload & Download buttons -->
    <div class="flex items-center space-x-3">
      <%= link_to "Upload Categories from YAML",
        new_category_import_path,
        class: "bg-green-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-md hover:bg-green-700 hover:shadow-lg transition" %>

      <%= link_to "Download current categories.yaml",
        download_categories_yaml_path,
        class: "bg-white text-gray-800 px-5 py-2.5 rounded-lg font-medium border border-gray-200 shadow-sm hover:shadow-md transition" %>
      
      <%= link_to "Download fresh template",
        '/categories.template.yaml',
        class: "bg-white text-gray-800 px-5 py-2.5 rounded-lg font-medium border border-gray-200 shadow-sm hover:shadow-md transition" %>
    </div>
  </div>

  <%# Persistent warning shown when total target percentages do not equal 100% %>
  <% if defined?(@percentages_ok) && !@percentages_ok %>
    <% delta = (@total_percentage - 100.0) %>
    <div class="mb-6 rounded-lg bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 shadow-sm">
      <strong class="font-semibold">Warning:</strong>
      <% if delta > 0 %>
        Total target percentages are <%= number_with_precision(@total_percentage, precision: 2) %>% (over by <%= number_with_precision(delta, precision: 2) %>%).
      <% else %>
        Total target percentages are <%= number_with_precision(@total_percentage, precision: 2) %>% (under by <%= number_with_precision(delta.abs, precision: 2) %>%).
      <% end %>
      Please update your categories or upload a corrected YAML to resolve this.
    </div>
  <% elsif defined?(@percentages_ok) && @percentages_ok %>
    <div class="mb-6 inline-flex items-center space-x-3 text-green-700 bg-green-50 border border-green-200 px-3 py-2 rounded-lg">
      <span class="font-semibold">Your category targets add up correctly</span>
      <span class="text-sm">Total: <%= number_with_precision(@total_percentage, precision: 2) %>%</span>
    </div>
  <% end %>

  <!-- Search box for keywords / category name -->
  <div class="mb-6">
    <label for="categories-search" class="block text-sm font-medium text-gray-700 mb-2">Search categories / keywords</label>
    <div class="flex items-center space-x-2">
      <input id="categories-search" type="search" placeholder="Search keywords or category name..." class="block w-full rounded-md border-gray-300 px-3 py-2" />
      <button id="categories-search-clear" type="button" class="px-3 py-2 bg-gray-100 rounded-md text-sm text-gray-700 hover:bg-gray-200">Clear</button>
    </div>
    <div id="categories-no-results" class="hidden mt-2 text-sm text-gray-600">No categories match your search.</div>
  </div>

  <!-- Categories grid -->
  <div id="categories" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @categories.each do |category| %>
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 transition hover:shadow-md hover:-translate-y-0.5">
        <div>
          <%= render category %>
        </div>

        <div class="mt-4">
          <%= link_to "View category",
                category,
                class: "inline-flex items-center text-blue-600 font-medium hover:text-blue-700" %>
        </div>
      </div>
    <% end %>
  </div>

</div>

<script>
  (function(){
    const input = document.getElementById('categories-search')
    const clear = document.getElementById('categories-search-clear')
    const noResults = document.getElementById('categories-no-results')
    if (!input) return

    function normalize(s){ return (s||'').toString().toLowerCase().trim() }

    function applyFilter(){
      const q = normalize(input.value)
      const grid = document.getElementById('categories')
      if (!grid) return
      const cards = Array.from(grid.children)
      let any = false

      cards.forEach(card => {
        const preview = card.querySelector('[data-keywords-preview]')
        const full = card.querySelector('[data-keywords-full]')
        const nameEl = card.querySelector('h2')
        const name = normalize(nameEl && nameEl.textContent)
        const kw = normalize((full && full.textContent) || (preview && preview.textContent) || '')

        if (!q || name.indexOf(q) !== -1 || kw.indexOf(q) !== -1) {
          card.style.display = ''
          // highlight match
          if (q && (name.indexOf(q) !== -1 || kw.indexOf(q) !== -1)) {
            card.classList.add('ring-2','ring-indigo-200')
          } else {
            card.classList.remove('ring-2','ring-indigo-200')
          }
          any = true
        } else {
          card.style.display = 'none'
          card.classList.remove('ring-2','ring-indigo-200')
        }
      })

      if (!any) noResults.classList.remove('hidden')
      else noResults.classList.add('hidden')
    }

    input.addEventListener('input', applyFilter)
    clear.addEventListener('click', function(){ input.value = ''; input.focus(); applyFilter() })
  })()
</script>

<!-- floating download button removed: download template is now in header -->
