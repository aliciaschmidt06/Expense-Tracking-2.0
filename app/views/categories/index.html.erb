<% content_for :title, "Categories" %>

<div class="min-h-screen w-full bg-gray-50 px-12 py-10">

  <!-- Header with title and upload button -->
  <div class="flex flex-col md:flex-row items-center justify-between mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 mb-4 md:mb-0">
      Spending Categories
    </h1>

    <!-- Upload & Download buttons -->
    <div class="flex items-center space-x-3">
      <%= link_to "Upload Config from YAML",
        new_category_import_path,
        class: "bg-green-600 text-white px-5 py-2.5 rounded-lg font-medium shadow-md hover:bg-green-700 hover:shadow-lg transition" %>

      <%= link_to "Download config.yaml",
        download_categories_yaml_path,
        class: "bg-white text-gray-800 px-5 py-2.5 rounded-lg font-medium border border-gray-200 shadow-sm hover:shadow-md transition" %>
    </div>
  </div>

  <!-- Percentage validation status -->
  <div id="percentage-status" class="mb-6"></div>

  <!-- Pie chart container -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8 mb-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Chart on the left -->
      <div class="flex-1">
        <canvas id="spending-pie-chart" style="max-height: 400px;"></canvas>
      </div>

      <!-- Categories list on the right -->
      <div class="flex-1">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Category Settings</h2>
        <div class="flex items-center gap-4 mb-2 text-sm font-medium text-gray-600 px-3">
          <div class="w-48">Name</div>
          <div class="flex-1 text-center">Target Allocation</div>
        </div>
        <div id="categories-list" class="space-y-2 max-h-96 overflow-y-auto">
          <!-- Categories will be populated here -->
        </div>
        <button id="save-percentages" class="mt-6 w-full bg-blue-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-blue-700 transition">
          Save Changes
        </button>
      </div>
    </div>
  </div>

  <!-- Income & Exclude Categories Section -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-2">Excluded Categories</h2>
    <p class="text-sm text-gray-700" id="other-categories">
      <!-- Excluded categories will be listed here -->
    </p>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  console.log('Chart loaded:', typeof Chart)

  const colors = [
    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
    '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FF6384',
    '#36A2EB', '#FFCE56', '#FF9F40', '#FF6384', '#C9CBCF'
  ]

  let currentData = []
  let chartInstance = null

  async function loadCategories() {
    console.log('loadCategories called')
    try {
      const response = await fetch('<%= pie_chart_data_path(format: :json) %>')
      console.log('Fetch response:', response.status)
      const result = await response.json()
      console.log('Fetched data:', result)
      currentData = result.categories
      // Initialize lock state for each category
      currentData.forEach(c => {
        if (!c.locked) c.locked = false
      })

      renderChart()
      renderCategoriesList()
      renderPercentageStatus(result)
    } catch (error) {
      console.error('Error loading categories:', error)
    }
  }

  function renderChart() {
    console.log('renderChart called, currentData:', currentData)
    console.log('Chart available:', typeof Chart)
    const ctx = document.getElementById('spending-pie-chart')
    console.log('Canvas element:', ctx)
    if (!ctx) {
      console.error('Canvas not found')
      return
    }
    
    if (chartInstance) {
      chartInstance.destroy()
    }

    chartInstance = new Chart(ctx.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: currentData.map(c => c.name),
        datasets: [{
          data: currentData.map(c => c.percentage),
          backgroundColor: colors.slice(0, currentData.length),
          borderColor: '#fff',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            position: 'bottom'
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const percentage = context.parsed
                return `${context.label}: ${percentage.toFixed(1)}%`
              }
            }
          }
        }
      }
    })
  }

  function updateInputs() {
    const rows = document.querySelectorAll('#categories-list > div')
    rows.forEach((row, index) => {
      const input = row.querySelector('input[type="number"]')
      if (input) input.value = Math.round(currentData[index].percentage) // percentage input
    })
  }

  function normalizePercentages() {
    // Calculate total for unlocked categories only
    const unlockedCats = currentData.filter(c => !c.locked)
    if (unlockedCats.length === 0) return
    
    const lockedTotal = currentData.filter(c => c.locked).reduce((sum, c) => sum + c.percentage, 0)
    const availableTotal = 100 - lockedTotal
    const unlockedTotal = unlockedCats.reduce((sum, c) => sum + c.percentage, 0)
    
    if (unlockedTotal === 0) return
    
    const factor = availableTotal / unlockedTotal
    unlockedCats.forEach(c => {
      c.percentage = Math.round(c.percentage * factor * 10) / 10
    })
    
    // Ensure exact 100%
    const newTotal = currentData.reduce((sum, c) => sum + c.percentage, 0)
    if (newTotal !== 100) {
      const adjustment = 100 - newTotal
      const firstUnlocked = unlockedCats[0]
      if (firstUnlocked) {
        firstUnlocked.percentage += adjustment
      }
    }
  }

  function renderCategoriesList() {
    const container = document.getElementById('categories-list')
    container.innerHTML = ''

    currentData.forEach((category, index) => {
      const div = document.createElement('div')
      div.className = 'flex items-center gap-4 p-3 bg-gray-50 rounded-lg border'

      // Name (clickable to edit)
      const nameContainer = document.createElement('div')
      nameContainer.className = 'w-48'
      const nameSpan = document.createElement('span')
      nameSpan.className = 'text-sm font-medium text-gray-700 cursor-pointer hover:text-blue-600'
      nameSpan.textContent = category.name
      nameSpan.addEventListener('click', () => {
        const input = document.createElement('input')
        input.type = 'text'
        input.value = category.name
        input.className = 'w-full px-2 py-1 border border-gray-300 rounded text-sm'
        input.addEventListener('blur', () => {
          category.name = input.value.trim() || category.name
          nameContainer.innerHTML = ''
          nameContainer.appendChild(nameSpan)
          nameSpan.textContent = category.name
        })
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            input.blur()
          }
        })
        nameContainer.innerHTML = ''
        nameContainer.appendChild(input)
        input.focus()
      })
      nameContainer.appendChild(nameSpan)

      // Target Allocation container
      const allocationContainer = document.createElement('div')
      allocationContainer.className = 'flex-1 flex items-center gap-2 justify-center'

      // Comparison select
      const comparisonSelect = document.createElement('select')
      comparisonSelect.className = 'px-2 py-1 border border-gray-300 rounded text-sm'
      const options = [
        { value: 'less_than', text: '<' },
        { value: 'equal_to', text: '=' },
        { value: 'greater_than', text: '>' }
      ]
      options.forEach(opt => {
        const option = document.createElement('option')
        option.value = opt.value
        option.textContent = opt.text
        if (category.target_comparison === opt.value) {
          option.selected = true
        }
        comparisonSelect.appendChild(option)
      })
      comparisonSelect.addEventListener('change', (e) => {
        category.target_comparison = e.target.value
      })

      // Percentage input
      const percentageInput = document.createElement('input')
      percentageInput.type = 'number'
      percentageInput.min = '0'
      percentageInput.max = '100'
      percentageInput.step = '1'
      percentageInput.value = Math.round(category.percentage)
      percentageInput.className = 'w-20 px-2 py-1 border border-gray-300 rounded text-sm text-center'
      percentageInput.addEventListener('input', (e) => {
        category.percentage = parseFloat(e.target.value) || 0
        normalizePercentages()
        renderChart()
        updateInputs()
        updatePercentageStatus()
      })

      allocationContainer.appendChild(comparisonSelect)
      allocationContainer.appendChild(percentageInput)

      // Lock button
      const lockButton = document.createElement('button')
      lockButton.className = 'px-2 py-1 rounded text-lg transition'
      lockButton.innerHTML = category.locked ? '🔒' : '🔓'
      lockButton.title = category.locked ? 'Unlock this category' : 'Lock this category'
      lockButton.style.backgroundColor = 'transparent'
      lockButton.style.border = 'none'
      lockButton.style.cursor = 'pointer'
      lockButton.style.fontSize = '1.5rem'
      lockButton.addEventListener('click', () => {
        category.locked = !category.locked
        lockButton.innerHTML = category.locked ? '🔒' : '🔓'
        lockButton.title = category.locked ? 'Unlock this category' : 'Lock this category'
        div.style.backgroundColor = category.locked ? '#d1d5db' : '#f3f4f6'
      })
      // Set initial row background
      if (category.locked) {
        div.style.backgroundColor = '#d1d5db'
      }

      div.appendChild(nameContainer)
      div.appendChild(allocationContainer)
      div.appendChild(lockButton)

      container.appendChild(div)
    })
  }

  function updatePercentageStatus() {
    const total = currentData.reduce((sum, c) => sum + c.percentage, 0)
    renderPercentageStatus({ total_percentage: total, percentages_ok: Math.abs(total - 100) < 0.01 })
  }

  function renderPercentageStatus(result) {
    const container = document.getElementById('percentage-status')
    const total = result.total_percentage
    const isOk = result.percentages_ok

    if (isOk) {
      container.innerHTML = `
        <div class="inline-flex items-center space-x-3 text-green-700 bg-green-50 border border-green-200 px-4 py-3 rounded-lg">
          <span class="font-semibold">Perfect! Your allocations total</span>
          <span class="text-sm font-mono">${total.toFixed(2)}%</span>
        </div>
      `
    } else {
      const delta = total - 100
      const message = delta > 0 ? `over by ${Math.abs(delta).toFixed(2)}%` : `under by ${Math.abs(delta).toFixed(2)}%`
      container.innerHTML = `
        <div class="inline-flex items-center space-x-3 text-yellow-800 bg-yellow-50 border border-yellow-300 px-4 py-3 rounded-lg">
          <span class="font-semibold">Allocations total ${total.toFixed(2)}%</span>
          <span class="text-sm font-mono">(${message})</span>
        </div>
      `
    }
  }

  async function renderOtherCategories() {
    const response = await fetch('<%= categories_path(format: :json) %>')
    const categories = await response.json()

    const container = document.getElementById('other-categories')
    
    // Filter to show only non-spending categories
    const excludedCats = categories.filter(c => c.category_type !== 'spending')
    const names = excludedCats.map(c => c.name).join(', ')
    
    container.textContent = names || 'None'
  }

  async function savePercentages() {
    const button = document.getElementById('save-percentages')
    button.disabled = true
    button.textContent = 'Saving...'

    try {
      const response = await fetch('<%= update_categories_percentages_path(format: :json) %>', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        },
        body: JSON.stringify({
          categories: currentData.map(c => ({
            id: c.id,
            name: c.name,
            percentage: c.percentage,
            target_comparison: c.target_comparison
          }))
        })
      })

      const result = await response.json()

      if (response.ok) {
        alert('Categories updated successfully!')
        window.location.href = '<%= root_path %>'
      } else {
        alert('Error saving categories: ' + (result.error || 'Unknown error'))
      }
    } catch (error) {
      console.error('Error saving percentages:', error)
      alert('Error saving categories')
    } finally {
      button.disabled = false
      button.textContent = 'Save Changes'
    }
  }

  document.getElementById('save-percentages').addEventListener('click', savePercentages)

  // Load data on page load
  loadCategories()
  renderOtherCategories()
</script>