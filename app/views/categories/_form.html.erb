<%= form_with(model: category, class: "space-y-6") do |form| %>

  <% if category.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md">
      <h2 class="font-semibold mb-2">
        <%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:
      </h2>

      <ul class="list-disc list-inside text-sm">
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Name -->
  <div class="flex items-center gap-4">
    <%= form.label :name,
          class: "w-44 text-sm font-medium text-gray-700" %>

    <%= form.text_field :name,
          class: "flex-1 rounded-md border border-gray-300 px-3 py-2
                  focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <!-- Target Percentage -->
  <div class="flex items-center gap-4">
    <%= form.label :target_percentage,
          "Target %",
          class: "w-44 text-sm font-medium text-gray-700" %>

    <%= form.number_field :target_percentage,
          step: 0.01,
          class: "flex-1 rounded-md border border-gray-300 px-3 py-2
                  focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <!-- Target Comparison -->
  <div class="flex items-center gap-4">
    <%= form.label :target_comparison,
      "Target comparison",
      class: "w-44 text-sm font-medium text-gray-700" %>

    <%= form.select :target_comparison, options_for_select([
      ['Equal to', 'equal_to'],
      ['Less than', 'less_than'],
      ['Greater than', 'greater_than'],
      ['Not applicable', 'not_applicable']
    ], selected: category.target_comparison), {}, class: "flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <!-- Keywords (tag editor) -->
  <div class="flex items-start gap-4">
    <%= form.label :keywords,
          class: "w-44 pt-2 text-sm font-medium text-gray-700" %>

    <div class="flex-1">
      <div id="keyword-editor" data-initial-tags="<%= j(category.keyword_list.to_json) %>" class="space-y-2">
        <div id="keyword-chips" class="flex flex-wrap gap-2">
          <%# Render existing keywords as chips server-side so they are visible even if JS doesn't run immediately %>
          <% Array(category.keyword_list || []).each_with_index do |kw, idx| %>
            <% next if kw.to_s.strip.blank? %>
            <span class="inline-flex items-center gap-2 bg-gray-100 text-sm text-gray-800 rounded-full px-3 py-1" data-server-tag-index="<%= idx %>">
              <span><%= kw %></span>
              <button type="button" class="ml-2 text-gray-500 hover:text-gray-700" aria-label="Remove <%= kw %>">&times;</button>
            </span>
          <% end %>
        </div>

        <div class="flex gap-2">
          <input id="keyword-input" type="text" placeholder="Add a keyword and press Enter or click Add" class="flex-1 rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" />
          <button type="button" id="keyword-add" class="px-3 py-2 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200">Add</button>
        </div>

        <p class="text-xs text-gray-500">Keywords are used to auto-assign transactions. Matching is case-insensitive and will match if the transaction name contains the keyword.</p>

        <!-- store JSON string for controller -->
        <%= form.hidden_field :keywords, value: (category.keyword_list.present? ? category.keyword_list.to_json : "[]"), id: "category_keywords_input" %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex justify-end gap-3 pt-4">
    <%= link_to "Cancel",
          categories_path,
          class: "px-4 py-2 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200" %>

    <%= form.submit "Save Category",
          class: "px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700" %>
  </div>

<% end %>
<script>
  (function(){
    const editor = document.getElementById('keyword-editor');
    if(!editor) return;

    const chipsContainer = document.getElementById('keyword-chips');
    const input = document.getElementById('keyword-input');
    const addBtn = document.getElementById('keyword-add');
    const hidden = document.getElementById('category_keywords_input');

    let tags = [];
    try {
      tags = JSON.parse(editor.dataset.initialTags || '[]');
      if(!Array.isArray(tags)) tags = [];
    } catch(e) {
      tags = [];
    }

    // Fallback: if parsing failed and there are server-rendered chips, read them
    if((!tags || tags.length === 0) && chipsContainer.children.length > 0){
      tags = Array.from(chipsContainer.querySelectorAll('span')).map(s => s.textContent.trim()).filter(Boolean);
    }

    const normalize = (t) => (t || '').toString().trim();

    function updateHidden(){
      hidden.value = JSON.stringify(tags.map(t => normalize(t)).filter(t => t.length > 0));
    }

    function render(){
      chipsContainer.innerHTML = '';
      tags.forEach((tag, idx) => {
        const t = normalize(tag);
        if(!t) return;

        const chip = document.createElement('span');
        chip.className = 'inline-flex items-center gap-2 bg-gray-100 text-sm text-gray-800 rounded-full px-3 py-1';
        chip.setAttribute('data-tag-index', idx);

        const txt = document.createElement('span');
        txt.textContent = t;
        chip.appendChild(txt);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ml-2 text-gray-500 hover:text-gray-700';
        btn.setAttribute('aria-label', `Remove ${t}`);
        btn.innerHTML = '&times;';
        btn.addEventListener('click', function(){
          tags = tags.filter((_, i) => i !== idx);
          render();
          updateHidden();
        });

        chip.appendChild(btn);
        chipsContainer.appendChild(chip);
      });
    }

    function addTagFromInput(){
      const v = normalize(input.value);
      if(!v) return;
      // avoid duplicates case-insensitive
      const present = tags.some(t => normalize(t).toLowerCase() === v.toLowerCase());
      if(!present){
        tags.push(v);
        updateHidden();
        render();
      }
      input.value = '';
      input.focus();
    }

    addBtn.addEventListener('click', addTagFromInput);

    input.addEventListener('keydown', function(e){
      if(e.key === 'Enter'){
        e.preventDefault();
        addTagFromInput();
      }
    });

    // initial render
    render();
    updateHidden();
  })();
</script>
