<div id="<%= dom_id category %>" class="space-y-4">

  <div>
    <h2 class="text-lg font-semibold text-gray-900">
      <%= category.name %>
    </h2>
  </div>

  <div class="grid grid-cols-2 gap-4 text-sm">
    <div class="bg-gray-50 rounded-lg px-4 py-3">
      <p class="text-gray-500">Target</p>
      <p class="font-medium text-gray-800">
        <%# Show target and its comparison rule (less_than / greater_than / equal_to / not_applicable) %>
        <% if category.target_comparison.present? && category.target_comparison != 'not_applicable' %>
          <%= category.target_percentage %>%
          <span class="text-xs text-gray-500">(<%= category.target_comparison.humanize.downcase %>)</span>
        <% else %>
          <%# not_applicable or blank: show N/A or the numeric if present %>
          <% if category.target_comparison == 'not_applicable' %>
            <span class="text-gray-600">N/A</span>
          <% else %>
            <%= category.target_percentage %>%
          <% end %>
        <% end %>
      </p>
    </div>

    <div class="bg-gray-50 rounded-lg px-4 py-3">
      <p class="text-gray-500">Keywords</p>
      <% full_keywords = category.keywords.to_s.presence || "—" %>
      <% preview = truncate(full_keywords, length: 80) %>

      <p class="font-medium text-gray-800" data-keywords-preview><%= preview %></p>
      <p class="font-medium text-gray-800 hidden break-words" data-keywords-full><%= full_keywords %></p>

      <% if full_keywords.present? && full_keywords.length > 80 %>
  <button type="button"
    class="mt-2 text-sm text-blue-600 hover:underline"
    aria-expanded="false"
    onclick="(function(btn){const root = btn.closest('.space-y-4'); if(!root) return; const pv = root.querySelector('[data-keywords-preview]'); const full = root.querySelector('[data-keywords-full]'); const expanded = full.classList.contains('hidden') === false; if(!expanded){ full.classList.remove('hidden'); pv.classList.add('hidden'); btn.textContent = 'Hide keywords'; btn.setAttribute('aria-expanded','true'); } else { full.classList.add('hidden'); pv.classList.remove('hidden'); btn.textContent = 'Show keywords'; btn.setAttribute('aria-expanded','false'); } })(this)">
          Show keywords
        </button>
      <% end %>
    </div>
  </div>

</div>
