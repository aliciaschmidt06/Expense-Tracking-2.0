<% content_for :title, "Import duplicates" %>

<div class="min-h-screen w-full bg-gray-50 px-12 py-10">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-semibold mb-4">Potential duplicates detected</h1>

    <div class="mb-4 text-sm text-gray-700">
      We detected <span class="font-medium"><%= @duplicates.size %></span> potential duplicate transaction(s) from the upload "<%= @meta['filename'] || 'uploaded file' %>" for account "<%= @meta['account_name'] %>".
      Please review each and choose whether to keep the uploaded row (add to database) or ignore it as a duplicate.
    </div>

    <div id="duplicates-list" class="space-y-3">
      <% @duplicates.each_with_index do |d, idx| %>
  <div class="bg-white p-3 rounded border flex items-center justify-between" data-dup-uid="<%= d['uid'] %>">
          <div class="min-w-0">
            <div class="font-medium truncate"><%= d['name'] %></div>
            <div class="text-xs text-gray-500 truncate"><%= d['account_name'] || '—' %> • <%= number_to_currency(d['amount']) %> • <%= d['transaction_type'] %></div>
            <div class="text-xs text-gray-400"><%= d['category_name'] %> • <%= d['created_at'] %></div>
          </div>

            <div class="ml-4 flex items-center space-x-2">
            <button class="btn-keep px-3 py-1 bg-green-600 text-white rounded text-sm" data-uid="<%= d['uid'] %>">Keep (add)</button>
            <button class="btn-ignore px-3 py-1 bg-gray-100 text-gray-700 rounded text-sm" data-uid="<%= d['uid'] %>">Ignore (duplicate)</button>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <div class="text-sm text-gray-600" id="duplicates-meta">
        Created: <span id="meta-created"><%= @meta['created_count'] || 0 %></span>
        — Skipped: <span id="meta-skipped"><%= @meta['skipped_count'] || 0 %></span>
        — Remaining: <span id="meta-remaining"><%= @duplicates.size %></span>
      </div>

      <div>
        <%= button_to 'Finish import', finish_import_imports_path, method: :post, class: 'px-4 py-2 bg-blue-600 text-white rounded' %>
        <%= link_to 'Cancel', new_import_path, class: 'ml-2 px-4 py-2 bg-gray-200 rounded' %>
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    async function sendDecision(uid, decision) {
      const res = await fetch('<%= resolve_duplicate_imports_path %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
        body: JSON.stringify({ uid: uid, decision: decision })
      })
      return res.json()
    }

    document.querySelectorAll('.btn-keep').forEach(btn => {
      btn.addEventListener('click', async function(e){
        const uid = this.dataset.uid
        this.disabled = true
        this.textContent = 'Adding...'
        const resp = await sendDecision(uid, 'keep')
        updateMeta(resp)
        // remove element from list
        const el = document.querySelector(`[data-dup-uid="${uid}"]`)
        if (el) el.remove()
      })
    })

    document.querySelectorAll('.btn-ignore').forEach(btn => {
      btn.addEventListener('click', async function(e){
        const uid = this.dataset.uid
        this.disabled = true
        this.textContent = 'Ignored'
        const resp = await sendDecision(uid, 'ignore')
        updateMeta(resp)
        const el = document.querySelector(`[data-dup-uid="${uid}"]`)
        if (el) el.remove()
      })
    })

    function updateMeta(resp) {
      if (!resp) return
      document.getElementById('meta-created').textContent = resp.meta.created_count || 0
      document.getElementById('meta-skipped').textContent = resp.meta.skipped_count || 0
      document.getElementById('meta-remaining').textContent = resp.remaining || 0
    }
  })()
</script>
