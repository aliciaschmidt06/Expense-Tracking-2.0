<div class="min-h-screen w-full bg-gray-50 flex flex-col">
  <!-- top navigation rendered in application layout -->
  
  <div class="max-w-6xl mx-auto px-6 md:px-12 py-8">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-8">Auto Upload Settings</h1>

    <div class="bg-white rounded-2xl shadow-md p-8 mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Folder Path</h2>
      <p class="text-gray-600 mb-4">Set the folder to monitor for automatic CSV uploads. Files dropped here will be automatically imported.</p>
      
      <%= form_with url: update_auto_upload_folder_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :folder_path, "Folder Path", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :folder_path, value: @folder_path, placeholder: "/path/to/upload/folder", class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
        <div>
          <%= f.submit "Update Folder", class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700" %>
        </div>
      <% end %>

      <% if @folder_path.present? %>
        <div class="mt-4 p-4 bg-green-50 border border-green-200 rounded">
          <p class="text-green-800">Monitoring: <%= @folder_path %></p>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-2xl shadow-md p-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Upload History</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">File Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Uploaded At</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @histories.each do |history| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= history.file_name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= history.uploaded_at.strftime('%Y-%m-%d %H:%M') %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if history.status == 'completed' %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Completed</span>
                  <% elsif history.status == 'failed' %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Failed</span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800"><%= history.status.titleize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if history.error_message.present? %>
                    <%= history.error_message %>
                  <% else %>
                    -
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
