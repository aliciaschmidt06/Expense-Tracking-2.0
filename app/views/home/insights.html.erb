<div class="min-h-screen w-full bg-white flex flex-col">
  <header class="px-12 py-6 border-b">
    <h1 class="text-2xl font-semibold text-gray-900">Insights</h1>
  </header>

  <main class="flex-1 p-8">
    <div class="max-w-6xl mx-auto">
      <!-- Filters -->
      <div class="bg-white rounded-lg border border-gray-100 p-4 mb-4 flex items-center space-x-4">
        <div class="flex items-center space-x-2">
          <label class="text-sm text-gray-600">Start</label>
          <input id="filter-start" type="date" value="<%= @range_start ? @range_start.strftime('%Y-%m-%d') : '' %>" class="border rounded px-2 py-1 text-sm">
        </div>
        <div class="flex items-center space-x-2">
          <label class="text-sm text-gray-600">End</label>
          <input id="filter-end" type="date" value="<%= @range_end ? @range_end.strftime('%Y-%m-%d') : '' %>" class="border rounded px-2 py-1 text-sm">
        </div>
        <div class="flex items-center space-x-2">
          <label class="text-sm text-gray-600">Category</label>
          <select id="filter-category" class="border rounded px-2 py-1 text-sm">
            <option value="">All</option>
            <% @categories.each do |c| %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% end %>
          </select>
        </div>
        <div class="ml-auto flex items-center space-x-2">
          <button id="btn-this-month" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">This month</button>
          <button id="btn-last-month" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">Last month</button>
          <button id="btn-so-far-year" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">So far this year</button>
        </div>
      </div>

      <!-- Chart card -->
      <div class="bg-white rounded-lg border border-gray-100 p-6">
        <h2 class="text-lg font-medium mb-4">Spending per month</h2>
        <div class="w-full">
          <canvas id="spendingChart" width="800" height="320"></canvas>
        </div>
      </div>

      <!-- Transactions list shown when clicking a bar -->
      <div id="insights-transactions" class="hidden mt-6 bg-white rounded-lg border border-gray-100 p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 id="insights-transactions-title" class="text-lg font-medium">Transactions</h3>
          <button id="insights-transactions-close" class="text-sm text-gray-500 hover:text-gray-700">Close</button>
        </div>
        <div class="overflow-x-auto">
          <table id="insights-transactions-table" class="min-w-full text-sm">
            <thead>
              <tr class="text-left text-xs text-gray-500">
                <th class="px-3 py-2">Date</th>
                <th class="px-3 py-2">Name</th>
                <th class="px-3 py-2">Account</th>
                <th class="px-3 py-2">Type</th>
                <th class="px-3 py-2 text-right">Amount</th>
              </tr>
            </thead>
            <tbody id="insights-transactions-body">
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    (function(){
      const ctx = document.getElementById('spendingChart').getContext('2d')
      let chart = null

      function formatParams(params) {
        return Object.keys(params).map(k => encodeURIComponent(k) + '=' + encodeURIComponent(params[k])).join('&')
      }

      async function fetchAndRender() {
        const start = document.getElementById('filter-start').value
        const end = document.getElementById('filter-end').value
        const category = document.getElementById('filter-category').value
        const params = { start_date: start, end_date: end }
        if (category) params.category_id = category
        const url = '<%= dashboard_data_path %>.json?' + formatParams(params)
        try {
          const res = await fetch(url)
          const body = await res.json()
          const labels = body.labels || []
          // two series: income and spend
          const income = body.income || []
          const spend = body.spend || []

          if (chart) {
            chart.data.labels = labels
            chart.data.datasets[0].data = income
            chart.data.datasets[1].data = spend
            chart.update()
          } else {
            chart = new Chart(ctx, {
              type: 'bar',
              data: {
                labels: labels,
                datasets: [
                  {
                    label: 'Income',
                    data: income,
                    backgroundColor: 'rgba(34,197,94,0.7)'
                  },
                  {
                    label: 'Spending',
                    data: spend,
                    backgroundColor: 'rgba(59,130,246,0.6)'
                  }
                ]
              },
              options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
              }
            })

            // handle clicks on bars to fetch transactions for that month/type
            document.getElementById('spendingChart').addEventListener('click', async function(evt){
              try {
                const points = chart.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, false)
                if (!points || points.length === 0) return
                const p = points[0]
                const datasetIndex = p.datasetIndex
                const index = p.index
                const label = chart.data.labels[index]

                // map dataset index to transaction_type
                const ttype = datasetIndex === 0 ? 'income' : 'expense'

                // parse label like 'Dec 2024' -> start/end dates
                function parseLabelToRange(lbl) {
                  const parts = lbl.split(' ')
                  if (parts.length < 2) return null
                  const monthName = parts[0]
                  const year = parseInt(parts[1], 10)
                  const months = { Jan:0, Feb:1, Mar:2, Apr:3, May:4, Jun:5, Jul:6, Aug:7, Sep:8, Oct:9, Nov:10, Dec:11 }
                  const m = months[monthName.substr(0,3)]
                  if (m === undefined || Number.isNaN(year)) return null
                  const start = new Date(year, m, 1)
                  const end = new Date(year, m+1, 0)
                  const pad = n => String(n).padStart(2, '0')
                  return { start: `${start.getFullYear()}-${pad(start.getMonth()+1)}-${pad(start.getDate())}`, end: `${end.getFullYear()}-${pad(end.getMonth()+1)}-${pad(end.getDate())}` }
                }

                const range = parseLabelToRange(label)
                if (!range) return

                // include category filter if set
                const category = document.getElementById('filter-category').value
                const params = { start_date: range.start, end_date: range.end, transaction_type: ttype }
                if (category) params.category_id = category
                const url = '<%= dashboard_category_transactions_path %>.json?' + formatParams(params)
                const res = await fetch(url)
                const body = await res.json()
                const rows = body.transactions || []

                const tbody = document.getElementById('insights-transactions-body')
                tbody.innerHTML = ''
                rows.forEach(r => {
                  const tr = document.createElement('tr')
                  tr.className = 'border-t'
                  tr.innerHTML = `<td class="px-3 py-2">${new Date(r.created_at).toISOString().slice(0,10)}</td><td class="px-3 py-2">${(r.name || '')}</td><td class="px-3 py-2">${(r.account_name || '')}</td><td class="px-3 py-2">${(r.transaction_type || '')}</td><td class="px-3 py-2 text-right">${(Number(r.amount) || 0).toFixed(2)}</td>`
                  tbody.appendChild(tr)
                })

                document.getElementById('insights-transactions-title').textContent = `${ttype.charAt(0).toUpperCase() + ttype.slice(1)} transactions for ${label}`
                document.getElementById('insights-transactions').classList.remove('hidden')
              } catch (e) {
                console.error('Failed to fetch transactions for bar click', e)
              }
            })

            document.getElementById('insights-transactions-close').addEventListener('click', function(){
              document.getElementById('insights-transactions').classList.add('hidden')
            })
          }
        } catch (err) {
          console.error('Failed to fetch dashboard data', err)
        }
      }

      // attach handlers
      document.getElementById('filter-start').addEventListener('change', fetchAndRender)
      document.getElementById('filter-end').addEventListener('change', fetchAndRender)
      document.getElementById('filter-category').addEventListener('change', fetchAndRender)

      document.getElementById('btn-this-month').addEventListener('click', () => {
        const now = new Date()
        const y = now.getFullYear()
        const m = String(now.getMonth()+1).padStart(2,'0')
        document.getElementById('filter-start').value = `${y}-${m}-01`
        document.getElementById('filter-end').value = `${y}-${m}-${String(now.getDate()).padStart(2,'0')}`
        fetchAndRender()
      })

      document.getElementById('btn-last-month').addEventListener('click', () => {
        const now = new Date()
        now.setMonth(now.getMonth() - 1)
        const y = now.getFullYear()
        const m = String(now.getMonth()+1).padStart(2,'0')
        const start = `${y}-${m}-01`
        const endDate = new Date(y, now.getMonth()+1, 0)
        const end = `${y}-${String(endDate.getDate()).padStart(2,'0')}`
        document.getElementById('filter-start').value = start
        document.getElementById('filter-end').value = `${y}-${m}-${String(endDate.getDate()).padStart(2,'0')}`
        fetchAndRender()
      })

      document.getElementById('btn-so-far-year').addEventListener('click', () => {
        const now = new Date()
        const y = now.getFullYear()
        document.getElementById('filter-start').value = `${y}-01-01`
        document.getElementById('filter-end').value = `${y}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`
        fetchAndRender()
      })

      // initial render
      fetchAndRender()
    })()
  </script>
</div>
