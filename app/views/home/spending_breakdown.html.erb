<div class="min-h-screen w-full bg-white flex flex-col">
  <header class="px-12 py-6 border-b flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Spending Breakdown</h1>
    <div>
      <button id="export-spending-plan" class="px-3 py-2 bg-blue-600 text-white rounded text-sm">Export CSV</button>
    </div>
  </header>

  <main class="flex-1">
    <section class="p-8 w-full">
      <div class="max-w-6xl mx-auto">
        <!-- Filters (same as insights) -->
        <div class="bg-white rounded-lg border border-gray-100 p-4 mb-4 flex items-center space-x-4">
          <div class="flex items-center space-x-2">
            <label class="text-sm text-gray-600">Start</label>
            <input id="filter-start" type="date" value="<%= @range_start ? @range_start.strftime('%Y-%m-%d') : '' %>" class="border rounded px-2 py-1 text-sm">
          </div>
          <div class="flex items-center space-x-2">
            <label class="text-sm text-gray-600">End</label>
            <input id="filter-end" type="date" value="<%= @range_end ? @range_end.strftime('%Y-%m-%d') : '' %>" class="border rounded px-2 py-1 text-sm">
          </div>
          <div class="flex items-center space-x-2">
            <label class="text-sm text-gray-600">Quick month</label>
            <input id="filter-month-text" type="text" placeholder="e.g. Dec 2024" class="border rounded px-2 py-1 text-sm w-48">
            <button id="btn-apply-month-text" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">Apply</button>
            <div id="filter-month-error" class="text-xs text-red-600 ml-2 hidden"></div>
          </div>
          <div class="ml-auto flex items-center space-x-2">
            <button id="btn-this-month" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">This month</button>
            <button id="btn-last-month" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">Last month</button>
            <button id="btn-so-far-year" class="px-3 py-1 bg-blue-50 text-blue-700 rounded text-sm">So far this year</button>
          </div>
        </div>

        <!-- Full grouped transactions table view -->

        <div id="grouped-transactions" class="bg-white rounded-lg border border-gray-100 p-4 mb-6 overflow-x-auto">
          <!-- Filled by JS: grouped categories with transactions under each -->
          <div id="grouped-container" class="w-full"></div>
        </div>
        
      </div>
    </section>
  </main>

  <script>
    (function(){
      function formatParams(params) {
        return Object.keys(params).map(k => encodeURIComponent(k) + '=' + encodeURIComponent(params[k])).join('&')
      }

      function money(v){
        return `$${(parseFloat(v) || 0).toFixed(2)}`
      }

      function titleCase(s) {
        if (!s) return ''
        return s.toString().replace(/\w\S*/g, function(txt){ return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); })
      }

      // Parse flexible month/year text like "Dec 2024", "dec 24", "12/2024" -> returns { start: 'YYYY-MM-DD', end: 'YYYY-MM-DD' } or null
      function parseMonthYear(input) {
        if (!input) return null
        const s = input.toString().trim().toLowerCase()
        const months = { jan:0, january:0, feb:1, february:1, mar:2, march:2, apr:3, april:3, may:4, jun:5, june:5, jul:6, july:6, aug:7, august:7, sep:8, sept:8, september:8, oct:9, october:9, nov:10, november:10, dec:11, december:11 }

        // month name + year (e.g. "dec 2024" or "dec-24")
        let m = null, y = null
        let m1 = s.match(/^([a-z]{3,9})[\.\-\s]*(\d{2,4})$/i)
        if (m1) {
          const mon = m1[1].toLowerCase()
          if (months.hasOwnProperty(mon)) m = months[mon]
          else {
            const ab = mon.substr(0,3)
            if (months.hasOwnProperty(ab)) m = months[ab]
          }
          y = parseInt(m1[2], 10)
        }

        // numeric month/year like 12/2024 or 12-24
        if (m === null) {
          let m2 = s.match(/^(\d{1,2})[\/\-](\d{2,4})$/)
          if (m2) {
            const mm = parseInt(m2[1], 10)
            if (mm >= 1 && mm <= 12) m = mm - 1
            y = parseInt(m2[2], 10)
          }
        }

        // year-only like "2025" or "25" -> whole year
        if (m === null) {
          const yOnly = s.match(/^(\d{2,4})$/)
          if (yOnly) {
            let yy = parseInt(yOnly[1], 10)
            if (yy < 100) yy = 2000 + yy
            const startStr = `${yy}-01-01`
            const endStr = `${yy}-12-31`
            return { start: startStr, end: endStr }
          }
        }

        if (m === null || !y) return null

        // two-digit year heuristic -> map to 2000-2099
        if (y < 100) y = 2000 + y

        try {
          const start = new Date(y, m, 1)
          const end = new Date(y, m + 1, 0)
          const pad = n => String(n).padStart(2, '0')
          const startStr = `${start.getFullYear()}-${pad(start.getMonth()+1)}-${pad(start.getDate())}`
          const endStr = `${end.getFullYear()}-${pad(end.getMonth()+1)}-${pad(end.getDate())}`
          return { start: startStr, end: endStr }
        } catch (e) {
          return null
        }
      }

      function showMonthError(msg) {
        const el = document.getElementById('filter-month-error')
        if (!el) return
        el.textContent = msg
        el.classList.remove('hidden')
        setTimeout(() => { el.classList.add('hidden'); el.textContent = '' }, 4000)
      }

      // deterministic color generation per category name
      function hashString(str) {
        let hash = 0
        if (!str) return hash
        for (let i = 0; i < str.length; i++) {
          hash = ((hash << 5) - hash) + str.charCodeAt(i)
          hash |= 0 // convert to 32bit int
        }
        return Math.abs(hash)
      }

      function colorsForName(name) {
        const h = hashString(name) % 360
        // title/text color (darker)
        const titleColor = `hsl(${h}, 65%, 28%)`
        // light background for alternating rows
        const rowLight = `hsl(${h}, 80%, 96%)`
        return { titleColor, rowLight }
      }

      async function fetchGrouped() {
        const start = document.getElementById('filter-start').value
        const end = document.getElementById('filter-end').value
        const params = { start_date: start, end_date: end }
        const url = '<%= spending_breakdown_data_path %>.json?' + formatParams(params)
        try {
          const res = await fetch(url)
          if (!res.ok) throw new Error('Network response not ok')
          const body = await res.json()

          // Income summary (element may have been removed); only set if present
          const income = (body.income_summary && body.income_summary.amount) ? body.income_summary.amount : 0
          const incomeEl = document.getElementById('income-summary')
          const incomeNoteEl = document.getElementById('income-note')
          if (incomeEl) incomeEl.textContent = money(income)
          if (incomeNoteEl) incomeNoteEl.textContent = body.income_summary && body.income_summary.note ? `(${body.income_summary.note})` : ''

          const totalSum = body.total_sum || 0

          const container = document.getElementById('grouped-container')
          container.innerHTML = ''

          try {
            const cats = Array.isArray(body.categories) ? body.categories : []
            cats.forEach((cat, idx) => {
              try {
                const isInvestment = (cat.name || '').toString().toLowerCase().includes('invest')
                const lname = (cat.name || '').toString().toLowerCase()
                const isIncome = lname === 'income'
                const isIgnore = lname === 'ignore'
                const isUnknown = lname === 'unknown'

                // header: category title with target & actual
                const header = document.createElement('div')
                header.className = 'w-full py-3 px-2 border-b flex items-center justify-between'

                const left = document.createElement('div')
                const title = document.createElement('div')
                title.className = 'text-lg font-semibold'
                title.textContent = titleCase(cat.name)
                // apply unique title color per category
                try {
                  const clr = colorsForName(cat.name)
                  title.style.color = clr.titleColor
                } catch (e) {
                  title.className += ' text-gray-900'
                }
                left.appendChild(title)

                const subtitle = document.createElement('div')
                subtitle.className = 'text-sm text-gray-600'
                const tp = (typeof cat.target_percentage !== 'undefined') ? `${parseFloat(cat.target_percentage).toFixed(1)}%` : ''
                const ap = (typeof cat.actual_percentage !== 'undefined') ? `${parseFloat(cat.actual_percentage).toFixed(1)}%` : ''
                // For Income, Ignore, and Unknown categories show only total (no target/percent)
                if (isIncome || isIgnore || isUnknown) {
                  subtitle.textContent = `Total: ${money(cat.sum || 0)}`
                } else {
                  subtitle.textContent = `Target: ${money(cat.target_amount || 0)} (${tp}) — Actual: ${money(cat.sum || 0)} (${ap})`
                }
                left.appendChild(subtitle)

                header.appendChild(left)

                // compute hit/miss coloring (don't color income, ignore, or unknown)
                let headerRight = document.createElement('div')
                if (!isIncome && !isIgnore && !isUnknown && (cat.target_amount || 0) > 0) {
                  // use configured comparison rule if present
                  const comp = cat.target_comparison || 'equal_to'
                  const actual = parseFloat(cat.sum || 0)
                  const target = parseFloat(cat.target_amount || 0)
                  let hit = false
                  if (comp === 'less_than') {
                    hit = actual <= target
                  } else if (comp === 'greater_than') {
                    hit = actual >= target
                  } else if (comp === 'equal_to') {
                    // allow small epsilon
                    hit = Math.abs(actual - target) < 0.005
                  } else {
                    // default behaviour
                    hit = actual >= target
                  }
                  const cls = hit ? 'text-green-700 bg-green-50 px-2 py-1 rounded' : 'text-red-700 bg-red-50 px-2 py-1 rounded'
                  headerRight.className = cls + ' text-sm'
                  // Build a human-readable comparison label (e.g. "Less than 50% target")
                  const pct = (typeof cat.target_percentage !== 'undefined') ? parseFloat(cat.target_percentage) : null
                  let labelText = ''
                  if (comp === 'not_applicable') {
                    labelText = 'Not applicable'
                  } else {
                    const pctText = (pct !== null && !isNaN(pct)) ? `${pct.toFixed(1)}%` : ''
                    if (pctText) {
                      labelText = hit ? `Met target of ${pctText}` : `Did not meet target of ${pctText}`
                    } else {
                      labelText = hit ? 'Met target' : 'Did not meet target'
                    }
                  }

                  headerRight.textContent = labelText
                } else if (isIncome) {
                  headerRight.className = 'text-xs text-gray-500'
                  headerRight.textContent = 'Income'
                } else {
                  headerRight.className = 'text-xs text-gray-500'
                  headerRight.textContent = ''
                }
                header.appendChild(headerRight)

                container.appendChild(header)

                // transactions table for this category
                const tableWrap = document.createElement('div')
                tableWrap.className = 'w-full overflow-x-auto mb-4'
                const table = document.createElement('table')
                table.className = 'min-w-full text-sm text-left'
                const thead = document.createElement('thead')
                thead.innerHTML = `<tr class="text-xs text-gray-500 uppercase"><th class="px-3 py-2">Date</th><th class="px-3 py-2">Name</th><th class="px-3 py-2">Account</th><th class="px-3 py-2">Type</th><th class="px-3 py-2 text-right">Amount</th></tr>`
                table.appendChild(thead)
                const tbody = document.createElement('tbody')

                const txs = Array.isArray(cat.transactions) ? cat.transactions : []
                if (txs.length === 0) {
                  const tr = document.createElement('tr')
                  tr.innerHTML = `<td class="px-3 py-6 text-gray-500" colspan="5">No transactions for this category in the selected range.</td>`
                  tbody.appendChild(tr)
                } else {
                  txs.forEach((t, j) => {
                    try {
                      const tr = document.createElement('tr')
                      tr.className = 'border-t'
                      const date = new Date(t.created_at)
                      // plain text type (no colored badges)
                      const typeHtml = t.transaction_type ? (t.transaction_type === 'income' ? 'Income' : 'Expense') : ''
                      tr.innerHTML = `
                        <td class="px-3 py-2 align-top">${date.toLocaleDateString()}</td>
                        <td class="px-3 py-2 align-top">${t.name}</td>
                        <td class="px-3 py-2 align-top">${t.account_name || ''}</td>
                        <td class="px-3 py-2 align-top">${typeHtml}</td>
                        <td class="px-3 py-2 text-right font-semibold">${money(t.amount)}</td>
                      `
                      // alternate row colours: white and a light tint of the category colour
                      try {
                        const clr = colorsForName(cat.name)
                        if ((j % 2) === 1) tr.style.backgroundColor = clr.rowLight
                        else tr.style.backgroundColor = 'white'
                      } catch (e) {
                        // ignore
                      }
                      tbody.appendChild(tr)
                    } catch (e) {
                      console.error('transaction render error', e, t)
                    }
                  })
                }

                table.appendChild(tbody)
                tableWrap.appendChild(table)
                container.appendChild(tableWrap)
              } catch (e) {
                console.error('category render error', e, cat)
              }
            })
            // If there are Unknown-category transactions, show a persistent button so users can go assign them
            try {
              const unknownCat = cats.find(c => (c.name || '').toString().toLowerCase() === 'unknown')
              const unknownHas = unknownCat && Array.isArray(unknownCat.transactions) && unknownCat.transactions.length > 0
              const groupedWrap = document.getElementById('grouped-transactions')
              if (unknownHas) {
                // only add once
                if (!document.getElementById('assign-unknown-btn')) {
                  const btnDiv = document.createElement('div')
                  btnDiv.id = 'assign-unknown-btn'
                  btnDiv.className = 'mt-4 p-4 bg-white border-t flex justify-center'
                  btnDiv.innerHTML = `<a href="<%= uncategorized_transactions_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600">Assign Unknown transactions (${unknownCat.transactions.length})</a>`
                  groupedWrap.appendChild(btnDiv)
                } else {
                  document.getElementById('assign-unknown-btn').style.display = 'block'
                }
              } else {
                const existing = document.getElementById('assign-unknown-btn')
                if (existing) existing.style.display = 'none'
              }
            } catch (e) {
              // non-fatal
            }
          } catch (e) {
            console.error('categories rendering failed', e, body && body.categories)
            const errDiv = document.createElement('div')
            errDiv.className = 'text-red-600'
            errDiv.textContent = `Render error: ${e && e.message ? e.message : String(e)}`
            container.appendChild(errDiv)
          }

        } catch (err) {
          console.error('failed to fetch grouped spending breakdown', err)
          const container = document.getElementById('grouped-container')
          const msg = (err && err.message) ? err.message : String(err)
          const status = (err && err.status) ? ` (status ${err.status})` : ''
          if (container) {
              // include stack where available to help debugging
              const stack = err && err.stack ? `\n\nStack:\n${err.stack}` : ''
              container.innerHTML = `<div class="text-red-600">Failed to load data${status}: ${msg}. Check browser console for more details.<pre class="mt-2 text-xs text-red-600">${stack}</pre></div>`
          }
        }
      }

      document.getElementById('filter-start').addEventListener('change', fetchGrouped)
      document.getElementById('filter-end').addEventListener('change', fetchGrouped)

      document.getElementById('btn-this-month').addEventListener('click', () => {
        const now = new Date()
        const y = now.getFullYear()
        const m = String(now.getMonth()+1).padStart(2,'0')
        document.getElementById('filter-start').value = `${y}-${m}-01`
        document.getElementById('filter-end').value = `${y}-${m}-${String(now.getDate()).padStart(2,'0')}`
        fetchGrouped()
      })

      // apply quick month text input
      document.getElementById('btn-apply-month-text').addEventListener('click', () => {
        const text = document.getElementById('filter-month-text').value
        const r = parseMonthYear(text)
        if (!r) {
          showMonthError('Could not parse month/year. Try "Dec 2024" or "12/2024"')
          return
        }
        document.getElementById('filter-start').value = r.start
        document.getElementById('filter-end').value = r.end
        fetchGrouped()
      })

      // press Enter in text box to apply
      document.getElementById('filter-month-text').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault()
          document.getElementById('btn-apply-month-text').click()
        }
      })

      document.getElementById('btn-last-month').addEventListener('click', () => {
        const now = new Date()
        now.setMonth(now.getMonth() - 1)
        const y = now.getFullYear()
        const m = String(now.getMonth()+1).padStart(2,'0')
        const start = `${y}-${m}-01`
        const endDate = new Date(y, now.getMonth()+1, 0)
        document.getElementById('filter-start').value = start
        document.getElementById('filter-end').value = `${y}-${m}-${String(endDate.getDate()).padStart(2,'0')}`
        fetchGrouped()
      })

      document.getElementById('btn-so-far-year').addEventListener('click', () => {
        const now = new Date()
        const y = now.getFullYear()
        document.getElementById('filter-start').value = `${y}-01-01`
        document.getElementById('filter-end').value = `${y}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`
        fetchGrouped()
      })

      // export CSV using current filters (keeps existing behaviour)
      document.getElementById('export-spending-plan').addEventListener('click', (e) => {
        const start = document.getElementById('filter-start').value
        const end = document.getElementById('filter-end').value
        const params = formatParams({ start_date: start, end_date: end, include_zero: '1' })
        const url = '<%= spending_breakdown_export_path %>.csv?' + params
        window.open(url, '_blank')
      })

      // initial load
      fetchGrouped()
    })()
  </script>
</div>
