<div class="min-h-screen w-full bg-gray-50 flex flex-col">
  <!-- top navigation rendered in application layout -->
  
  <script>
    // Auto-refresh when auto-uploads complete
    let lastTransactionCount = <%= @transactions_count %>;
    
    function checkForNewTransactions() {
      fetch('<%= dashboard_data_path(format: :json) %>')
        .then(response => response.json())
        .then(data => {
          if (data.transactions_count > lastTransactionCount) {
            console.log('📥 New transactions detected! Auto-refreshing...');
            lastTransactionCount = data.transactions_count;
            // Small delay to ensure database has synced
            setTimeout(() => {
              location.reload();
            }, 1000);
          }
        })
        .catch(error => console.log('Check poll error:', error));
    }
    
    // Poll every 10 seconds for new transactions (from auto-uploads)
    setInterval(checkForNewTransactions, 10000);
  </script>
    <div class="max-w-6xl mx-auto px-6 md:px-12">
  <% if @has_transactions && @has_real_categories %>
